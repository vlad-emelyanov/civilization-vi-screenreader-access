<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="12.0" DefaultTargets="Default" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Default</Configuration>
    <Name>Screen Reader Access</Name>
    <Guid>49224623-c629-4e7a-a5cb-ad822828072e</Guid>
    <ProjectGuid>86d90124-1370-4574-ada6-d21e12e6f95f</ProjectGuid>
    <ModVersion>1</ModVersion>
    <Teaser>A mod that allows textual information from game to be output via a running screen reader, allowing blind and visually impaired</Teaser>
    <Description>A mod that allows textual information from game to be output via a running screen reader, allowing blind and visually impaired players to play the game.</Description>
    <Authors>BlindFuryC</Authors>
    <SpecialThanks>
    </SpecialThanks>
    <AffectsSavedGames>true</AffectsSavedGames>
    <SupportsSinglePlayer>true</SupportsSinglePlayer>
    <SupportsMultiplayer>true</SupportsMultiplayer>
    <SupportsHotSeat>true</SupportsHotSeat>
    <CompatibleVersions>1.2,2.0</CompatibleVersions>
    <AssemblyName>ScreenReaderAccess</AssemblyName>
    <RootNamespace>ScreenReaderAccess</RootNamespace>
    <FrontEndActionData><![CDATA[<FrontEndActions><ImportFiles id="SRAccess_FE_UpdateFiles"><File priority="10001">Assets/UI/ToolTips/PlotToolTip.lua</File><File priority="10001">Assets/UI/Accessibility/ScreenReader.lua</File><File priority="10001">Assets/UI/Panels/StatusMessagePanel.lua</File><File priority="10001">Assets/UI/Panels/NotificationPanel.lua</File><File priority="10001">Assets/UI/Frontend/FrontEndPopup.lua</File><File priority="10001">Assets/UI/Frontend/LoadGameMenu.lua</File><File priority="10001">Assets/UI/Frontend/LoadSaveMenu_Shared.lua</File><File priority="10001">Assets/UI/Frontend/AdvancedSetup.lua</File><File priority="10001">Assets/UI/Frontend/MainMenu.lua</File><File priority="10001">Assets/UI/Frontend/MapSelect.lua</File><File priority="10001">Assets/UI/Frontend/MultiSelectWindow.lua</File><File priority="10001">Assets/UI/Frontend/LeaderPicker.lua</File><File priority="10001">Assets/UI/Frontend/CityStatePicker.lua</File><File priority="10001">Assets/UI/Frontend/HostGame.lua</File><File priority="10001">Assets/UI/Frontend/StagingRoom.lua</File><File priority="10001">Assets/UI/Frontend/Lobby.lua</File><File priority="10001">Assets/UI/Frontend/JoiningRoom.lua</File><File priority="10001">Assets/UI/Frontend/LoadScreen.lua</File><File priority="10001">Assets/UI/Frontend/TutorialSetup.lua</File><File priority="10001">Assets/UI/Popups/PopupDialog.lua</File><File priority="10001">Assets/UI/Options.lua</File><File priority="10001">Assets/UI/Accessibility/KeyNavEditBox.lua</File><File priority="10001">Assets/UI/Accessibility/KeyNavSetup.lua</File><File priority="10001">Assets/UI/Accessibility/KeyboardNavigation.lua</File></ImportFiles><UpdateDatabase id="SRAccessModifyConfigurationDB"><File>Database/extrahotkeys_queries_configuration.sql</File><File>Database/keynav_queries_configuration.sql</File></UpdateDatabase></FrontEndActions>]]></FrontEndActionData>
    <InGameActionData><![CDATA[<InGameActions><ImportFiles id="SRAccess_IG_UpdateFiles"><File priority="10001">Assets/UI/ToolTips/PlotToolTip.lua</File><File priority="10001">Assets/UI/Accessibility/ScreenReader.lua</File><File priority="10001">Assets/UI/Menus/InGameTopOptionsMenu.lua</File><File priority="10001">Assets/UI/Panels/StatusMessagePanel.lua</File><File priority="10001">Assets/UI/Panels/NotificationPanel.lua</File><File priority="10001">Assets/UI/Panels/ProductionPanel.lua</File><File priority="10001">Assets/UI/Popups/TechCivicCompletedPopup.lua</File><File priority="10001">Assets/UI/Popups/AdvisorPopup.lua</File><File priority="10001">Assets/UI/Accessibility/ScreenReaderPlotUtils.lua</File><File priority="10001">Assets/UI/Accessibility/PlotDescription.lua</File><File priority="10001">Assets/UI/Popups/PopupDialog.lua</File><File priority="10001">Assets/UI/Options.lua</File><File priority="10001">Assets/UI/WorldInput.lua</File><File priority="10001">Assets/UI/Accessibility/KeyNavEditBox.lua</File><File priority="10001">Assets/UI/Accessibility/KeyNavSetup.lua</File><File priority="10001">Assets/UI/Accessibility/KeyboardNavigation.lua</File></ImportFiles><AddUserInterfaces id="SRAccess_IG_ExpansionIntroAccess"><Properties><Context>InGame</Context></Properties><File>UI/Additions/ExpansionIntroAccess.xml</File></AddUserInterfaces><AddUserInterfaces id="SRAccess_IG_InGameAccess"><Properties><Context>InGame</Context></Properties><File>UI/Additions/InGameAccess.xml</File></AddUserInterfaces><AddGameplayScripts id="SRAccess_IG_GameplayScripts"><File priority="10001">Assets/UI/Accessibility/ScreenReaderPlotUtils.lua</File></AddGameplayScripts><UpdateDatabase id="SRAccessModifyGameplayDB"><File>Database/extrahotkeys_queries_gameplay.sql</File></UpdateDatabase></InGameActions>]]></InGameActionData>
